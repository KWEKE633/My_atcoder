{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make)",
      "Bash(make:*)",
      "Bash(./a.out)",
      "Bash(./a.out:*)",
      "Bash(c++:*)",
      "Bash(g++:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)"
    ],
    "deny": [
      "Edit(atcoder/**)",
      "Write(atcoder/**)"
    ]
  }
}
